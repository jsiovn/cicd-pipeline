{
  "name": "cicd-pipeline",
  "version": "1.0.0",
  "private": true,
  "description": "A small orders API taken through PR checks, tests, Docker images and deploys with GitHub Actions",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "test:coverage": "vitest run --coverage",
    "demo:coverage-100": "vitest run --root examples/coverage-trap --coverage --coverage.include=rating.js --coverage.reporter=text-summary",
    "demo:coverage-gap": "vitest run --root examples/coverage-trap --coverage --coverage.reporter=text --coverage.thresholds.lines=0",
    "demo:coverage-threshold": "vitest run --root examples/coverage-trap --coverage --coverage.reporter=text"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "express": "^5.3.0",
    "pg": "^8.23.1",
    "pino": "^10.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@vitest/coverage-v8": "^5.1.1",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "msw": "^3.0.7",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.1"
  }
}
